      "id": "2af7dac2-6928-45a6-b72c-4e7590d13c45",
      "name": "Загрузить HTML страницы",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        -32
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const html = ($input.item.json.data || '').toString();\nconst lowerHtml = html.toLowerCase();\n\n// Определяем CMS\nlet cms = 'unknown';\nif (html.includes('wp-content') || html.includes('/wp-json/') || html.includes('wp-includes')) cms = 'WordPress';\nelse if (lowerHtml.includes('ghost') && lowerHtml.includes('content=\"ghost')) cms = 'Ghost';\nelse if (lowerHtml.includes('blogger') || lowerHtml.includes('blogspot')) cms = 'Blogger';\nelse if (html.includes('Joomla!') || html.includes('/components/com_')) cms = 'Joomla';\nelse if (html.includes('sites/default/files') || html.includes('Drupal.settings')) cms = 'Drupal';\nelse if (lowerHtml.includes('bitrix')) cms = 'Bitrix';\nelse if (html.includes('/typo3conf/')) cms = 'TYPO3';\nelse if (lowerHtml.includes('modx')) cms = 'MODX';\nelse if (lowerHtml.includes('tilda')) cms = 'Tilda';\n\n// Признаки форума — если находим, помечаем и будем отсеивать\nconst forumSignatures = [\n  'phpbb', 'vbulletin', 'discourse', 'invision power board', 'ipboard',\n  'simplemachines', 'smf', 'xenforo', 'vanilla forums', 'forum rules',\n  'thread starter', 'new topic', 'post reply', 'viewforum', 'viewtopic'\n];\nconst isForum = forumSignatures.some(sig => lowerHtml.includes(sig)) \n  || /\\/forum(s)?\\//.test(lowerHtml) \n  || /\\bforum\\b/.test(lowerHtml.match(/<title[^>]*>(.*?)<\\/title>/i)?.[1]?.toLowerCase() || '');\n\n// Признаки того, что это именно блог (а не форум/статичный сайт)\nconst isBlog = /\\/blog\\//.test(lowerHtml) \n  || lowerHtml.includes('rel=\"category tag\"') \n  || lowerHtml.includes('posted in') \n  || lowerHtml.includes('published on')\n  || lowerHtml.includes('article:published_time')\n  || cms === 'WordPress' || cms === 'Ghost' || cms === 'Blogger';\n\n// Признаки формы комментариев именно под постом (не форумной темы)\nconst hasCommentForm = (\n  /<form[^>]*id=[\"']?comment/i.test(html) ||\n  /<form[^>]*class=[\"'][^\"']*comment/i.test(html) ||\n  lowerHtml.includes('leave a reply') ||\n  lowerHtml.includes('leave a comment') ||\n  lowerHtml.includes('post a comment') ||\n  lowerHtml.includes('оставить комментарий') ||\n  lowerHtml.includes('добавить комментарий')\n);\n\nconst requiresRegistration = /(you must be logged in to post a comment|login to comment|войдите чтобы оставить комментарий)/i.test(html);\n\nreturn {\n  json: {\n    ...($input.item.json),\n    html: undefined,\n    cms,\n    isForum,\n    isBlog,\n    hasCommentForm,\n    requiresRegistration\n  }\n};"
      },
