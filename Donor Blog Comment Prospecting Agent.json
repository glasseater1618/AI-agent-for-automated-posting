{
  "name": "Donor Blog Comment Prospecting Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "62176ccf-6a91-416f-bfb9-03e7705b31fe",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1728,
        160
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ {\n  \"niches\": [\"casino\", \"sport betting\", \"btst casino\"],\n  \"queries_per_niche\": [\n    \"\\\"powered by wordpress\\\" \\\"leave a comment\\\" blog\",\n    \"\\\"powered by wordpress\\\" \\\"post a comment\\\" blog\",\n    \"\\\"powered by ghost\\\" comments blog\",\n    \"\\\"powered by blogger\\\" comments blog\",\n    \"blog \\\"leave a reply\\\" comment\"\n  ]\n} }}",
        "options": {}
      },
      "id": "e499fed7-4ed8-4e04-b908-dcb0907216fe",
      "name": "Задать ниши и запросы",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        -1280,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst combos = [];\nfor (const niche of data.niches) {\n  for (const q of data.queries_per_niche) {\n    combos.push({ niche, query: `${q} ${niche}` });\n  }\n}\nreturn combos.map(c => ({ json: c }));"
      },
      "id": "ec28d0ee-becf-45e5-8d92-1f085a732694",
      "name": "Сформировать список запросов",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1056,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://google.serper.dev/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $('ApiKeys').item.json.serper_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"q\": $json.query } }}",
        "options": {}
      },
      "id": "6c7700a0-3d41-4de8-b1f6-7dddfc582cf1",
      "name": "Поиск через Google CSE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -832,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  const results = item.json.items || [];\n  for (const r of results) {\n    items.push({\n      json: {\n        url: r.link,\n        title: r.title,\n        snippet: r.snippet,\n        niche: item.json.niche || null\n      }\n    });\n  }\n}\n// убираем дубли по домену\nconst seen = new Set();\nconst unique = [];\nfor (const it of items) {\n  try {\n    const domain = new URL(it.json.url).hostname;\n    if (!seen.has(domain)) {\n      seen.add(domain);\n      unique.push(it);\n    }\n  } catch (e) {}\n}\nreturn unique;"
      },
      "id": "3b7b4c7a-93a9-4801-9392-cceca583ff2f",
      "name": "Извлечь уникальные домены",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
